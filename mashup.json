{
  "id": "sigf/eldencraft",
  "version": "0.3.0",
  "name": "EldenCraft",
  "tagline": "Minecraft survival inside Elden Ring: gather, craft and build in the Lands Between, and fight its bosses with Minecraft weapons (offline).",
  "how_to_play": [
    "Explore the Lands Between as a Minecraft player: gather, craft tools, build among the ruins and fight Elden Ring's enemies with Minecraft weapons.",
    "Press Play: a hidden Minecraft starts first, then Elden Ring offline. Load your character; Minecraft takes over movement once it has connected.",
    "Minecraft's keys move, mine, build and fight; E inventory. R uses doors, levers, items and Sites of Grace. Escape still opens Elden Ring's menu.",
    "F8 Minecraft's pause menu (options, GUI scale), F9 first-person camera, F10 hands control back to Elden Ring, F5 camera modes.",
    "Minecraft hearts are your health: at zero you die in Elden Ring and respawn at a grace. Bosses drop named gear and enchanted books once per world."
  ],
  "kind": "passthrough",
  "games": [
    {
      "game": "eldenring",
      "role": "host",
      "label": "Elden Ring",
      "engine": "Elden Ring (FromSoftware, D3D12) + me3 native DLL eldencraft (Rust, fromsoftware-rs 59fbd3b)",
      "apps": {
        "steam": "1245620"
      },
      "runtime": "exe 2.7.1 only (App Ver. 1.17.1)"
    },
    {
      "game": "minecraft",
      "role": "guest",
      "label": "Minecraft",
      "engine": "Minecraft Java 26.3 + Fabric mod eldencraft (Java)",
      "mc": "26.3",
      "loader": "fabric@0.19.5",
      "java": "25"
    }
  ],
  "requires": [
    {
      "id": "me3",
      "version": "0.13.0",
      "license": "MIT OR Apache-2.0, shipped unchanged",
      "page": "https://github.com/garyttierney/me3/releases/tag/v0.13.0",
      "note": "installed into ELDEN RING/EldenCraft/me3 by the app; it starts Elden Ring offline without Easy Anti-Cheat",
      "source": {
